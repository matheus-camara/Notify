<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Matheus Câmara</Authors>
    <Description>Lightweight notification pattern for .NET applications with optional JSON
      localization.</Description>
    <PackageTags>notifications;validation;localization;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/matheus-camara/Notifiable</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Notifiable</PackageId>
    <Version>1.0.1</Version>
  </PropertyGroup>
</Project>